async function verificarCaixa() {
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  const snap = await db.collection('caixas').where('usuario','==',usuario.nome).where('status','==','aberto').limit(1).get();
  if (!snap.empty) {
    const doc = snap.docs[0];
    caixaAberto = true;
    caixaId = doc.id;
    const data = doc.data();
    const hora = data.abertura?.seconds ? new Date(data.abertura.seconds*1000).toLocaleTimeString('pt-BR') : '—';
    document.getElementById('caixaDot').className = 'caixa-dot open';
    document.getElementById('caixaStatusText').textContent = 'Caixa Aberto';
    document.getElementById('caixaHorario').textContent = `Aberto às ${hora} | Fundo: R$ ${Number(data.fundo||0).toFixed(2)}`;
    await calcularResumoCaixa();
  } else {
    caixaAberto = false; caixaId = null;
    document.getElementById('caixaDot').className = 'caixa-dot closed';
    document.getElementById('caixaStatusText').textContent = 'Caixa Fechado';
    document.getElementById('caixaHorario').textContent = '—';
    document.getElementById('resumoCaixa').innerHTML = '';
  }
}

async function abrirCaixa() {
  if (caixaAberto) { toast('Caixa já está aberto!', 'error'); return; }
  const fundo = Number(document.getElementById('fundoCaixa').value || 0);
  const obs = document.getElementById('obsCaixa').value;
  const ref = await db.collection('caixas').add({ fundo, obs, abertura: new Date(), usuario: usuario.nome, status: 'aberto' });
  await db.collection('movimentacoes').add({ caixaId: ref.id, tipo:'abertura', descricao:'Abertura de caixa', valor:fundo, usuario:usuario.nome, data:new Date() });
  caixaId = ref.id; caixaAberto = true;
  toast('Caixa aberto!');
  verificarCaixa(); carregarMovCaixa();
}

async function fecharCaixa() {
  if (!caixaAberto) { toast('Caixa não está aberto', 'error'); return; }
  if (!confirm('Fechar o caixa agora?')) return;
  await db.collection('caixas').doc(caixaId).update({ status:'fechado', fechamento: new Date() });
  toast('Caixa fechado!');
  caixaAberto = false; caixaId = null;
  verificarCaixa();
}

async function registrarMovCaixa() {
  if (!caixaId) { toast('Abra o caixa primeiro!', 'error'); return; }
  const tipo = document.getElementById('tipoMovCaixa').value;
  const valor = Number(document.getElementById('valorMovCaixa').value);
  const motivo = document.getElementById('motivoMovCaixa').value;
  if (!valor) { toast('Digite o valor', 'error'); return; }
  await db.collection('movimentacoes').add({ caixaId, tipo, descricao: motivo || tipo, valor, usuario: usuario.nome, data: new Date() });
  document.getElementById('valorMovCaixa').value = '';
  document.getElementById('motivoMovCaixa').value = '';
  toast('Registrado!');
  carregarMovCaixa(); calcularResumoCaixa();
}

async function calcularResumoCaixa() {
  if (!caixaId) return;
  const snap = await db.collection('movimentacoes').where('caixaId','==',caixaId).get();
  const movs = snap.docs.map(d => d.data());
  const totalVendas = movs.filter(m=>m.tipo==='venda').reduce((s,m)=>s+m.valor,0);
  const totalSangria = movs.filter(m=>m.tipo==='sangria').reduce((s,m)=>s+m.valor,0);
  const totalSuprimento = movs.filter(m=>m.tipo==='suprimento').reduce((s,m)=>s+m.valor,0);
  const fundo = movs.find(m=>m.tipo==='abertura')?.valor || 0;
  const saldo = fundo + totalVendas + totalSuprimento - totalSangria;
  document.getElementById('resumoCaixa').innerHTML = `
    <div class="summary-card green"><div class="summary-label">Vendas do Dia</div><div class="summary-value">R$ ${totalVendas.toFixed(2)}</div></div>
    <div class="summary-card amber"><div class="summary-label">Sangrias</div><div class="summary-value">R$ ${totalSangria.toFixed(2)}</div></div>
    <div class="summary-card blue"><div class="summary-label">Suprimentos</div><div class="summary-value">R$ ${totalSuprimento.toFixed(2)}</div></div>
    <div class="summary-card green"><div class="summary-label">Saldo Atual</div><div class="summary-value">R$ ${saldo.toFixed(2)}</div></div>
  `;
}

async function carregarMovCaixa() {
  if (!caixaId) { document.getElementById('tabelaCaixa').innerHTML = '<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text3)">Abra o caixa para ver movimentações</td></tr>'; return; }
  const snap = await db.collection('movimentacoes').where('caixaId','==',caixaId).orderBy('data','desc').get();
  const cores = { venda:'green', abertura:'blue', sangria:'red', suprimento:'amber', fechamento:'red' };
  document.getElementById('tabelaCaixa').innerHTML = snap.docs.map(d => {
    const m = d.data();
    const hora = m.data?.seconds ? new Date(m.data.seconds*1000).toLocaleTimeString('pt-BR') : '—';
    return `<tr>
      <td style="color:var(--text2);font-size:12px">${hora}</td>
      <td><span class="badge badge-${cores[m.tipo]||'blue'}">${m.tipo}</span></td>
      <td>${m.descricao||'—'}</td>
      <td style="color:var(--accent);font-weight:600">R$ ${Number(m.valor||0).toFixed(2)}</td>
      <td style="color:var(--text2);font-size:12px">${m.usuario||'—'}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text3)">Nenhuma movimentação</td></tr>';
}

// ══════════════════════════════════════════
// RELATÓRIO
// ══════════════════════════════════════════
function mudarRelTab(tab, el) {
  relTab = tab;
  document.querySelectorAll('.rel-tab').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('relCustom').style.display = tab === 'custom' ? 'block' : 'none';
  if (tab !== 'custom') carregarRelatorio();
}

async function carregarRelatorio() {
  const agora = new Date();
  let inicio, fim = new Date();
  if (relTab === 'hoje') { inicio = new Date(); inicio.setHours(0,0,0,0); }
  else if (relTab === 'semana') { inicio = new Date(); inicio.setDate(agora.getDate()-7); }
  else if (relTab === 'mes') { inicio = new Date(); inicio.setDate(1); inicio.setHours(0,0,0,0); }
  else {
    const di = document.getElementById('relDataInicio').value;
    const df = document.getElementById('relDataFim').value;
    if (!di || !df) return;
    inicio = new Date(di); fim = new Date(df); fim.setHours(23,59,59);
  }

  let query = db.collection('vendas').orderBy('data','desc');
  const snap = await query.get();
  const vendas = snap.docs.map(d=>({id:d.id,...d.data()})).filter(v => {
    const d = v.data?.seconds ? new Date(v.data.seconds*1000) : new Date(v.data);
    return d >= inicio && d <= fim;
  });

  const totalGeral = vendas.reduce((s,v)=>s+(v.total||0),0);
  const qtdVendas = vendas.length;
  const ticketMedio = qtdVendas ? totalGeral/qtdVendas : 0;
  const totalDesconto = vendas.reduce((s,v)=>s+(v.desconto||0),0);

  document.getElementById('resumoRel').innerHTML = `
    <div class="summary-card green"><div class="summary-label">Faturamento</div><div class="summary-value">R$ ${totalGeral.toFixed(2)}</div></div>
    <div class="summary-card blue"><div class="summary-label">Nº Vendas</div><div class="summary-value">${qtdVendas}</div></div>
    <div class="summary-card amber"><div class="summary-label">Ticket Médio</div><div class="summary-value">R$ ${ticketMedio.toFixed(2)}</div></div>
    <div class="summary-card red"><div class="summary-label">Descontos</div><div class="summary-value">R$ ${totalDesconto.toFixed(2)}</div></div>
  `;

  // Gráfico formas
  const formas = {};
  vendas.forEach(v => { formas[v.forma||'Outro'] = (formas[v.forma||'Outro']||0) + (v.total||0); });
  const maxF = Math.max(...Object.values(formas), 1);
  document.getElementById('graficoForma').innerHTML = `
    <div class="bar-chart">
      ${Object.entries(formas).map(([k,v])=>`
        <div class="bar-item">
          <div class="bar-val">R$ ${v.toFixed(0)}</div>
          <div class="bar-fill" style="height:${(v/maxF)*80}px"></div>
          <div class="bar-label">${k.substring(0,8)}</div>
        </div>
      `).join('')}
    </div>
  `;

  // Top produtos
  const prods = {};
  vendas.forEach(v => (v.itens||[]).forEach(i => { prods[i.nome] = (prods[i.nome]||0) + i.qtd; }));
  const topP = Object.entries(prods).sort((a,b)=>b[1]-a[1]).slice(0,5);
  document.getElementById('topProdutos').innerHTML = topP.length ? topP.map(([n,q],i)=>`
    <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
      <div style="width:20px;height:20px;background:var(--accent-dim);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--accent)">${i+1}</div>
      <div style="flex:1;font-size:13px">${n}</div>
      <div style="font-size:13px;font-weight:600;color:var(--accent)">${q} un</div>
    </div>
  `).join('') : '<div style="text-align:center;padding:20px;color:var(--text3)">Sem dados</div>';

  // Tabela
  document.getElementById('tabelaRelatorio').innerHTML = vendas.length ? vendas.map(v => {
    const d = v.data?.seconds ? new Date(v.data.seconds*1000) : new Date(v.data);
    return `<tr>
      <td style="font-size:12px;color:var(--text2)">${d.toLocaleString('pt-BR')}</td>
      <td>${v.usuario||'—'}</td>
      <td>${(v.itens||[]).length} itens</td>
      <td><span class="badge badge-blue">${v.forma||'—'}</span></td>
      <td style="color:var(--accent);font-weight:600">R$ ${Number(v.total||0).toFixed(2)}</td>
      <td><button class="btn btn-secondary btn-sm" onclick='imprimirCupom(${JSON.stringify(v)})'>🖨</button></td>
    </tr>`;
  }).join('') : '<tr><td colspan="6" style="text-align:center;padding:30px;color:var(--text3)">Nenhuma venda no período</td></tr>';
}

function exportarRelatorio() {
  const rows = [['Data','Operador','Itens','Forma','Total']];
  document.querySelectorAll('#tabelaRelatorio tr').forEach(tr => {
    const cols = [...tr.querySelectorAll('td')].map(td => td.textContent.trim());
    if (cols.length) rows.push(cols);
  });
  const csv = rows.map(r=>r.join(',')).join('\n');
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
  a.download = 'relatorio-chinelos-mix.csv';
  a.click();
  toast('Relatório exportado!');
}

// ══════════════════════════════════════════
// FUNCIONÁRIOS
// ══════════════════════════════════════════
let editandoFuncId = null;

function abrirModalFuncionario(id = null) {
  editandoFuncId = id;
  document.getElementById('modalFuncTitulo').textContent = id ? 'Editar Funcionário' : 'Novo Funcionário';
  if (id) {
    const f = funcionarios.find(x => x.id === id);
    if (!f) return;
    document.getElementById('fNome').value = f.nome || '';
    document.getElementById('fCargo').value = f.cargo || 'Vendedor(a)';
    document.getElementById('fFuncao').value = f.funcao || '';
    document.getElementById('fTurno').value = f.turno || 'Manhã';
    document.getElementById('fTel').value = f.telefone || '';
    document.getElementById('fSenha').value = '';
    document.getElementById('fPermissao').value = f.permissao || 'operador';
  } else {
    ['fNome','fFuncao','fTel','fSenha'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('fCargo').value = 'Vendedor(a)';
    document.getElementById('fTurno').value = 'Manhã';
    document.getElementById('fPermissao').value = 'operador';
  }
  abrirModal('modalFuncionario');
}

async function salvarFuncionario() {
  const nome = document.getElementById('fNome').value.trim();
  if (!nome) { toast('Nome obrigatório', 'error'); return; }
  const dados = {
    nome,
    cargo: document.getElementById('fCargo').value,
    funcao: document.getElementById('fFuncao').value.trim(),
    turno: document.getElementById('fTurno').value,
    telefone: document.getElementById('fTel').value,
    permissao: document.getElementById('fPermissao').value,
    ativo: true
  };
  const senha = document.getElementById('fSenha').value;
  if (senha) dados.senha = senha;

  if (editandoFuncId) {
    await db.collection('funcionarios').doc(editandoFuncId).update(dados);
    toast('Funcionário atualizado!');
  } else {
    dados.cadastro = new Date();
    await db.collection('funcionarios').add(dados);
    toast('Funcionário cadastrado!');
  }
  editandoFuncId = null;
  fecharModal('modalFuncionario');
}

function renderFuncionarios() {
  const el = document.getElementById('listaFuncionarios');
  if (!funcionarios.length) {
    el.innerHTML = '<div class="empty"><div class="empty-icon">👥</div>Nenhum funcionário cadastrado</div>';
    return;
  }
  // Atualizar select do ponto
  const sel = document.getElementById('funcPontoSel');
  if (sel) {
    const atual = sel.value;
    sel.innerHTML = '<option value="">— Selecionar funcionário —</option>' +
      funcionarios.map(f => `<option value="${f.id}|${f.nome}">${f.nome}</option>`).join('');
    sel.value = atual;
  }

  const cores = ['var(--accent)','var(--blue)','var(--amber)','var(--red)'];
  el.innerHTML = funcionarios.map((f, i) => {
    const iniciais = f.nome.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase();
    const cor = cores[i % cores.length];
    return `<div class="func-card">
      <div class="func-avatar" style="background:${cor}22;color:${cor}">${iniciais}</div>
      <div class="func-info">
        <div class="func-nome">${f.nome}</div>
        <div class="func-cargo">${f.cargo}${f.funcao ? ' · ' + f.funcao : ''} · ${f.turno||'—'}</div>
        ${f.telefone ? `<div style="font-size:11px;color:var(--text3);margin-top:2px">${f.telefone}</div>` : ''}
      </div>
      <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end">
        <span class="badge badge-${f.permissao==='admin'?'red':f.permissao==='gerente'?'amber':'green'}">${f.permissao}</span>
        <div style="display:flex;gap:4px;margin-top:4px">
          <button class="btn btn-blue btn-icon btn-sm" onclick="abrirModalFuncionario('${f.id}')" title="Editar">✏️</button>
          <button class="btn btn-danger btn-icon btn-sm" onclick="excluirFuncionario('${f.id}')" title="Excluir">🗑</button>
        </div>
      </div>
    </div>`;
  }).join('');
}

async function excluirFuncionario(id) {
  if (confirm('Remover funcionário?')) {
    await db.collection('funcionarios').doc(id).delete();
    toast('Removido');
  }
}

// ══════════════════════════════════════════
// PONTO ELETRÔNICO — 4 tipos
// ══════════════════════════════════════════
async function registrarPontoTipo(tipo) {
  const sel = document.getElementById('funcPontoSel');
  const val = sel?.value;
  if (!val) { toast('Selecione um funcionário!', 'error'); return; }
  const [funcId, funcNome] = val.split('|');

  const labels = {
    entrada:      { label: '▶ Entrada',       cor: '#22c55e' },
    saida_almoco: { label: '🍽 Saída Almoço',  cor: '#f59e0b' },
    volta_almoco: { label: '↩ Volta Almoço',   cor: '#3b82f6' },
    saida:        { label: '◼ Saída',          cor: '#ef4444' },
  };

  // Limite: 1 registro por tipo, por funcionário, por dia
  const inicioDia = new Date(); inicioDia.setHours(0,0,0,0);
  const snapDup = await db.collection('pontos').orderBy('timestamp','desc').limit(200).get();
  const jaBateu = snapDup.docs.map(d=>d.data()).some(p => {
    const t = p.timestamp?.seconds ? new Date(p.timestamp.seconds*1000) : new Date(p.timestamp);
    return p.funcId === funcId && p.tipo === tipo && t >= inicioDia;
  });
  if (jaBateu) {
    toast(`${funcNome} já bateu "${labels[tipo]?.label||tipo}" hoje!`, 'error');
    return;
  }

  const agora = new Date();
  await db.collection('pontos').add({
    funcId, funcNome, tipo,
    label: labels[tipo]?.label || tipo,
    hora: agora.toLocaleTimeString('pt-BR'),
    data: agora.toLocaleDateString('pt-BR'),
    timestamp: agora,
    registradoPor: usuario.nome
  });
  toast(`${labels[tipo]?.label} registrada para ${funcNome}!`);
  carregarPontos();
}

async function registrarPonto(tipo) {
  await registrarPontoTipo(tipo);
}

async function carregarPontos() {
  const hoje = new Date().toLocaleDateString('pt-BR', {weekday:'long', day:'numeric', month:'long'});
  const el = document.getElementById('pontoData');
  if (el) el.textContent = hoje;

  // Atualizar select
  const sel = document.getElementById('funcPontoSel');
  if (sel && funcionarios.length && sel.options.length <= 1) {
    sel.innerHTML = '<option value="">— Selecionar funcionário —</option>' +
      funcionarios.map(f => `<option value="${f.id}|${f.nome}">${f.nome}</option>`).join('');
  }

  const inicioDia = new Date(); inicioDia.setHours(0,0,0,0);
  const snap = await db.collection('pontos').orderBy('timestamp','desc').limit(100).get();
  const pontos = snap.docs.map(d=>d.data()).filter(p => {
    const t = p.timestamp?.seconds ? new Date(p.timestamp.seconds*1000) : new Date(p.timestamp);
    return t >= inicioDia;
  });

  const cores = {
    entrada:      'badge-green',
    saida_almoco: 'badge-amber',
    volta_almoco: 'badge-blue',
    saida:        'badge-red',
  };

  const tabel = document.getElementById('tabelaPonto');
  if (!tabel) return;
  tabel.innerHTML = pontos.length ? pontos.map(p => `
    <tr>
      <td><strong>${p.funcNome}</strong></td>
      <td><span class="badge ${cores[p.tipo]||'badge-blue'}">${p.label||p.tipo}</span></td>
      <td style="font-family:'Rajdhani',sans-serif;font-size:15px;font-weight:700;color:var(--accent)">${p.hora}</td>
      <td style="font-size:12px;color:var(--text2)">${p.data}</td>
    </tr>
  `).join('') : '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--text3)">Nenhum registro hoje</td></tr>';
}

// ══════════════════════════════════════════
// TROCA
// ══════════════════════════════════════════
function addEntrada() {
  const codigo = document.getElementById('codEntrada').value.trim();
  const qtd = Number(document.getElementById('qtdEntrada').value || 1);
  const p = produtos.find(x => String(x.codigo) === String(codigo));
  if (!p) { toast('Produto não encontrado!', 'error'); return; }
  entrada.push({ codigo:p.codigo, nome:p.nome, qtd, preco:Number(p.valor) });
  renderTroca();
}

function addSaida() {
  const codigo = document.getElementById('codSaida').value.trim();
  const qtd = Number(document.getElementById('qtdSaida').value || 1);
  const p = produtos.find(x => String(x.codigo) === String(codigo));
  if (!p) { toast('Produto não encontrado!', 'error'); return; }
  saida.push({ codigo:p.codigo, nome:p.nome, qtd, preco:Number(p.valor) });
  renderTroca();
}

function renderTroca() {
  const tE = entrada.reduce((s,i)=>s+i.qtd*i.preco,0);
  const tS = saida.reduce((s,i)=>s+i.qtd*i.preco,0);
  document.getElementById('tabelaEntrada').innerHTML = entrada.map((p,i)=>`<tr><td>${p.nome}</td><td>${p.qtd}</td><td>R$ ${p.preco.toFixed(2)}</td><td><button class="btn btn-danger btn-icon btn-sm" onclick="entrada.splice(${i},1);renderTroca()">×</button></td></tr>`).join('') || '<tr><td colspan="4" style="text-align:center;padding:12px;color:var(--text3)">—</td></tr>';
  document.getElementById('tabelaSaida').innerHTML = saida.map((p,i)=>`<tr><td>${p.nome}</td><td>${p.qtd}</td><td>R$ ${p.preco.toFixed(2)}</td><td><button class="btn btn-danger btn-icon btn-sm" onclick="saida.splice(${i},1);renderTroca()">×</button></td></tr>`).join('') || '<tr><td colspan="4" style="text-align:center;padding:12px;color:var(--text3)">—</td></tr>';
  document.getElementById('totalEntrada').textContent = tE.toFixed(2);
  document.getElementById('totalSaida').textContent = tS.toFixed(2);
  const dif = tS - tE;
  document.getElementById('difTroca').textContent = `R$ ${Math.abs(dif).toFixed(2)} ${dif>0?'(cliente paga)':dif<0?'(loja devolve)':''}`;
  document.getElementById('difTroca').style.color = dif>0?'var(--amber)':dif<0?'var(--red)':'var(--accent)';
}

async function finalizarTroca() {
  if (!entrada.length && !saida.length) { toast('Adicione produtos!', 'error'); return; }
  const tE = entrada.reduce((s,i)=>s+i.qtd*i.preco,0);
  const tS = saida.reduce((s,i)=>s+i.qtd*i.preco,0);
  const forma = document.getElementById('pagTroca').value;
  await db.collection('trocas').add({ entrada, saida, totalEntrada:tE, totalSaida:tS, diferenca:tS-tE, forma, usuario:usuario.nome, data:new Date() });
  for (const item of entrada) { const p=produtos.find(x=>x.codigo===item.codigo); if(p) await db.collection('produtos').doc(p.id).update({estoque:(p.estoque||0)+item.qtd}); }
  for (const item of saida) { const p=produtos.find(x=>x.codigo===item.codigo); if(p) await db.collection('produtos').doc(p.id).update({estoque:Math.max(0,(p.estoque||0)-item.qtd)}); }
  // Imprimir cupom de troca profissional
  imprimirCupom({ entrada:[...entrada], saida:[...saida], forma, usuario:usuario.nome, data:new Date() }, 'troca');
  toast('Troca finalizada!');
  entrada=[]; saida=[]; renderTroca();
}

// ══════════════════════════════════════════
// UTILITÁRIOS
// ══════════════════════════════════════════
function abrirModal(id) { document.getElementById(id).classList.add('open'); }
function fecharModal(id) { document.getElementById(id).classList.remove('open'); }

document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
});

function toast(msg, tipo='success') {
  const el = document.getElementById('toast');
  el.textContent = (tipo==='success'?'✅ ':'❌ ') + msg;
  el.className = 'toast show ' + tipo;
  setTimeout(() => el.classList.remove('show'), 3000);
}
