// SCANNER — câmera (genérico) + suporte a pistola USB (input + Enter)
const SCAN_FORMATS = (typeof Html5QrcodeSupportedFormats !== 'undefined') ? [
  Html5QrcodeSupportedFormats.CODE_128,
  Html5QrcodeSupportedFormats.CODE_39,
  Html5QrcodeSupportedFormats.EAN_13,
  Html5QrcodeSupportedFormats.EAN_8,
  Html5QrcodeSupportedFormats.UPC_A,
  Html5QrcodeSupportedFormats.UPC_E,
  Html5QrcodeSupportedFormats.ITF,
  Html5QrcodeSupportedFormats.QR_CODE
] : undefined;
const scanners = {};
function toggleScanner(readerId, inputId, onRead) {
  const el = document.getElementById(readerId);
  if (scanners[readerId]) { scanners[readerId].stop().catch(()=>{}); scanners[readerId]=null; el.innerHTML=''; return; }
  const s = new Html5Qrcode(readerId, { formatsToSupport: SCAN_FORMATS });
  scanners[readerId] = s;
  const config = { fps:15, qrbox:{width:260,height:140}, aspectRatio:1.6 };
  s.start({facingMode:'environment'}, config, (text) => {
    if (inputId) document.getElementById(inputId).value = text;
    s.stop().catch(()=>{}); scanners[readerId]=null; el.innerHTML='';
    if (typeof onRead === 'function') onRead();
  }).catch(e => { scanners[readerId]=null; alert('Erro câmera: '+e); });
}
function toggleScannerProd() { toggleScanner('readerProd','pCodigo'); }
function toggleScannerVenda() { toggleScanner('readerVenda','codVenda', adicionarPorCodigo); }

// ETIQUETA — escolha de numerações antes de imprimir
let _escolhaEtiquetaCtx = null;
function abrirEscolhaEtiqueta(prodId) {
  try {
    const p = produtos.find(x => x.id === prodId);
    if (!p) { toast('Produto não encontrado', 'error'); return; }
    const irmaos = produtos.filter(x =>
      (x.nome||'').trim().toLowerCase() === (p.nome||'').trim().toLowerCase() &&
      (x.cor ||'').trim().toLowerCase() === (p.cor ||'').trim().toLowerCase()
    ).sort((a,b) => String(a.numero||'').localeCompare(String(b.numero||''), 'pt', {numeric:true}));

    // Se não houver irmãos cadastrados, imprime só esse produto direto
    const lista = irmaos.length > 0 ? irmaos : [p];
    _escolhaEtiquetaCtx = { irmaos: lista };

    document.getElementById('escolhaEtiquetaInfo').innerHTML =
      `<strong>${p.nome}</strong> — Cor: <strong>${p.cor||'—'}</strong> · Valor: <strong style="color:var(--accent)">R$ ${Number(p.valor||0).toFixed(2)}</strong><div style="margin-top:6px;font-size:12px;color:var(--text3)">Todas selecionadas por padrão. Clique para tirar/colocar.</div>`;

    const grade = document.getElementById('escolhaEtiquetaGrade');
    grade.innerHTML = lista.map(it => `
      <button type="button" data-pid="${it.id}" data-on="1" onclick="toggleEscolhaTam('${it.id}')"
        style="min-width:54px;padding:10px 12px;border-radius:8px;cursor:pointer;font-weight:700;font-size:14px;
        border:1.5px solid var(--accent);background:var(--accent-dim);color:var(--accent)">
        ${it.numero||'—'}<div style="font-size:10px;font-weight:500;color:var(--text3);margin-top:2px">est: ${it.estoque||0}</div>
      </button>
    `).join('');
    abrirModal('modalEscolhaEtiqueta');
  } catch (e) {
    console.error('abrirEscolhaEtiqueta erro:', e);
    toast('Erro ao abrir etiquetas: '+e.message, 'error');
  }
}
function toggleEscolhaTam(pid) {
  const btn = document.querySelector(`#escolhaEtiquetaGrade button[data-pid="${pid}"]`);
  if (!btn) return;
  const on = btn.dataset.on === '1';
  btn.dataset.on = on ? '0' : '1';
  btn.style.borderColor = on ? 'var(--border2)' : 'var(--accent)';
  btn.style.background  = on ? 'transparent'   : 'var(--accent-dim)';
  btn.style.color       = on ? 'var(--text2)'  : 'var(--accent)';
}
function imprimirEtiquetasSelecionadas() {
  if (!_escolhaEtiquetaCtx) { toast('Abra o seletor primeiro', 'error'); return; }
  const ids = Array.from(document.querySelectorAll('#escolhaEtiquetaGrade button[data-on="1"]'))
    .map(b => b.dataset.pid);
  if (ids.length === 0) { toast('Selecione ao menos uma numeração', 'error'); return; }
  const sel = _escolhaEtiquetaCtx.irmaos.filter(it => ids.includes(it.id));
  // ABRE A JANELA ANTES de fechar o modal (mantém o gesto do clique → evita pop-up blocker)
  imprimirEtiquetas(sel);
  fecharModal('modalEscolhaEtiqueta');
}

