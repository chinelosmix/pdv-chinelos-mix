function renderBusca() {
  const t = document.getElementById('buscaInput').value.toLowerCase();
  const lista = produtos.filter(p => (p.nome||'').toLowerCase().includes(t) || String(p.codigo).includes(t));
  document.getElementById('listaBusca').innerHTML = lista.map(p => `
