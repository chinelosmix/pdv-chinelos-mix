        </div>
      </td>
    </tr>`;
  }).join('') : '<tr><td colspan="9" style="text-align:center;color:var(--text3);padding:30px">Nenhum produto encontrado</td></tr>';
}

function atualizarResumoEstoque() {
  const total = produtos.length;
  const baixo = produtos.filter(p => p.estoque <= (p.estoqueMin||5)).length;
  const valorTotal = produtos.reduce((s,p) => s + (Number(p.estoque)||0) * (Number(p.valor)||0), 0);
  const custoTotal = produtos.reduce((s,p) => s + (Number(p.estoque)||0) * (Number(p.custo)||0), 0);
  const lucroTotal = valorTotal - custoTotal;
  const margemPct = valorTotal > 0 ? ((lucroTotal / valorTotal) * 100).toFixed(1) : 0;
  const totalItens = produtos.reduce((s,p) => s + (Number(p.estoque)||0), 0);
  const ticketMedio = totalItens > 0 ? (valorTotal / totalItens) : 0;
  document.getElementById('resumoEstoque').innerHTML = `
    <div class="summary-card blue"><div class="summary-label">Total Produtos</div><div class="summary-value">${total}</div></div>
    <div class="summary-card red"><div class="summary-label">Estoque Baixo</div><div class="summary-value">${baixo}</div></div>
    <div class="summary-card green"><div class="summary-label">Valor em Estoque</div><div class="summary-value">R$ ${valorTotal.toFixed(2)}</div></div>
    <div class="summary-card amber"><div class="summary-label">Custo Total</div><div class="summary-value">R$ ${custoTotal.toFixed(2)}</div></div>
    <div class="summary-card green"><div class="summary-label">Margem Lucro</div><div class="summary-value">${margemPct}%</div><div style="font-size:11px;color:var(--text2)">R$ ${lucroTotal.toFixed(2)}</div></div>
    <div class="summary-card blue"><div class="summary-label">Ticket Médio / Item</div><div class="summary-value">R$ ${ticketMedio.toFixed(2)}</div></div>
  `;
}

