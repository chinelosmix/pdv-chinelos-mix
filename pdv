      <td><button class="btn btn-primary btn-sm" onclick="selecionarProduto('${p.codigo}')">Adicionar</button></td>
    </tr>
  `).join('') || '<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text3)">Nenhum resultado</td></tr>';
}

function selecionarProduto(codigo) {
  const p = produtos.find(x => String(x.codigo) === String(codigo));
  if (!p) return;
  const item = venda.find(x => x.codigo === p.codigo);
  if (item) { item.qtd++; } else { venda.push({ codigo:p.codigo, nome:p.nome, valor:Number(p.valor), qtd:1 }); }
  fecharModal('buscaModal');
  renderVenda();
}

