function adicionarPorCodigo() {
  const codigo = document.getElementById('codVenda').value.trim();
  const qtd = Number(document.getElementById('qtdVenda').value || 1);
  if (!codigo) { toast('Digite o código', 'error'); return; }
  const produto = produtos.find(p => String(p.codigo) === String(codigo));
  if (!produto) { toast('Produto não encontrado!', 'error'); return; }
  const item = venda.find(x => x.codigo === produto.codigo);
  if (item) { item.qtd += qtd; } else {
    venda.push({ codigo: produto.codigo, nome: produto.nome, valor: Number(produto.valor), qtd });
  }
  document.getElementById('codVenda').value = '';
  document.getElementById('qtdVenda').value = 1;
  renderVenda();
}

function renderVenda() {
  const el = document.getElementById('listaVenda');
  if (!venda.length) {
    el.innerHTML = '<div class="empty"><div class="empty-icon">🛒</div>Nenhum item adicionado</div>';
    calcularTotais(); return;
  }
  el.innerHTML = venda.map((p, i) => `
    <div class="item-row">
      <div class="item-nome">
        <div style="font-weight:500">${p.nome}</div>
        <div style="font-size:11px;color:var(--text2)">R$ ${p.valor.toFixed(2)} / un</div>
      </div>
      <div class="item-qtd"><input type="number" value="${p.qtd}" min="1" onchange="alterarQtd(${i},this.value)"></div>
      <div class="item-preco">R$ ${(p.valor*p.qtd).toFixed(2)}</div>
      <button class="btn btn-danger btn-icon btn-sm" onclick="removerItem(${i})">×</button>
    </div>
  `).join('');
  calcularTotais();
}

function alterarQtd(i, qtd) {
  venda[i].qtd = Math.max(1, Number(qtd));
  renderVenda();
}

function removerItem(i) { venda.splice(i,1); renderVenda(); }
function limparVenda() { if (venda.length && confirm('Limpar venda?')) { venda = []; renderVenda(); } }

function calcularTotais() {
  const subtotal = venda.reduce((s,p) => s + p.valor*p.qtd, 0);
  const desconto = Number(document.getElementById('desconto')?.value || 0);
  const total = Math.max(0, subtotal - desconto);
  document.getElementById('vSubtotal').textContent = subtotal.toFixed(2);
  document.getElementById('vTotal').textContent = total.toFixed(2);
  calcularTroco();
}

function calcularTroco() {
  const total = Number(document.getElementById('vTotal')?.textContent || 0);
  const pago = Number(document.getElementById('valorRecebido')?.value || 0);
  document.getElementById('vTroco').textContent = Math.max(0, pago - total).toFixed(2);
}

async function finalizarVenda() {
  if (!venda.length) { toast('Adicione produtos!', 'error'); return; }
  const subtotal = venda.reduce((s,p) => s + p.valor*p.qtd, 0);
  const desconto = Number(document.getElementById('desconto').value || 0);
  const total = Math.max(0, subtotal - desconto);
  const forma = document.getElementById('formaPgto').value;

  const dadosVenda = {
    itens: venda.map(x=>({...x})),
    subtotal, desconto, total, forma,
    usuario: usuario.nome,
    data: new Date()
  };

  const ref = await db.collection('vendas').add(dadosVenda);
  ultimoCupom = dadosVenda;

  // Descontar estoque
  for (const item of venda) {
    const prod = produtos.find(x => x.codigo === item.codigo);
    if (prod) await db.collection('produtos').doc(prod.id).update({ estoque: Math.max(0,(prod.estoque||0)-item.qtd) });
  }

  // Registrar no caixa
  if (caixaId) {
    await db.collection('movimentacoes').add({
      caixaId, tipo:'venda', descricao:`Venda #${ref.id.slice(-6)}`,
      valor: total, forma, usuario: usuario.nome, data: new Date()
    });
  }

  imprimirCupom(dadosVenda);
  toast('Venda finalizada! ✅');
  venda = [];
  document.getElementById('desconto').value = 0;
  document.getElementById('valorRecebido').value = '';
  renderVenda();
}

function montarTextoCupom(v) {
  // Versão texto puro para WhatsApp
  const data = new Date().toLocaleString('pt-BR');
  let c = `CHINELOS MIX\n`;
  c += `${data}\nVendedor: ${v.usuario}\n`;
  c += `--------------------------------\n`;
  (v.itens||[]).forEach(i => {
    c += `${i.nome}\n${i.qtd}x R$ ${Number(i.valor).toFixed(2)} = R$ ${(Number(i.valor)*i.qtd).toFixed(2)}\n`;
  });
  c += `--------------------------------\n`;
  c += `Subtotal: R$ ${Number(v.subtotal||v.total).toFixed(2)}\n`;
  if (v.desconto) c += `Desconto: R$ ${Number(v.desconto).toFixed(2)}\n`;
  c += `TOTAL: R$ ${Number(v.total).toFixed(2)}\n`;
  c += `Pagamento: ${v.forma}\n`;
  c += `--------------------------------\nObrigado pela preferência!`;
  return c;
}

