let _deferredInstall = null;
function _mostrarBotoesInstall(show) {
  ['btnInstalarApp','btnInstalarAppLogin'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = show ? '' : 'none';
  });
}
const _isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
const _isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  _deferredInstall = e;
  if (!_isStandalone) _mostrarBotoesInstall(true);
});
window.addEventListener('appinstalled', () => {
  _deferredInstall = null;
  _mostrarBotoesInstall(false);
});
// Sempre mostra o botão quando não está rodando como app instalado
// (fallback mostra instruções manuais se o navegador não disparar o prompt)
if (!_isStandalone) {
  window.addEventListener('load', () => _mostrarBotoesInstall(true));
}
async function instalarApp() {
  if (_deferredInstall) {
    _deferredInstall.prompt();
    const choice = await _deferredInstall.userChoice;
    _deferredInstall = null;
    if (choice && choice.outcome === 'accepted') _mostrarBotoesInstall(false);
    return;
  }
  if (_isIOS) {
    alert('Para instalar no iPhone/iPad:\n\n1. Toque no botão Compartilhar (□↑) do Safari\n2. Role e toque em "Adicionar à Tela de Início"\n3. Toque em "Adicionar"');
    return;
  }
  alert('Para instalar:\n\n• Android (Chrome): menu ⋮ → "Instalar app" ou "Adicionar à tela inicial"\n• Computador (Chrome/Edge): ícone ⊕ na barra de endereço\n\nSe não aparecer, abra esta página direto no navegador (não dentro de um app).');
}

