async function salvarProduto() {
  const codBase = document.getElementById('pCodigo').value.trim();
  const nome = document.getElementById('pNome').value.trim();
  const cor = document.getElementById('pCor').value.trim();
  const valor = Number(document.getElementById('pValor').value);
  const custo = Number(document.getElementById('pCusto').value) || 0;
  const estoqueMin = Number(document.getElementById('pEstoqueMin').value) || 5;

  if (!codBase || !nome) { toast('Código e nome obrigatórios', 'error'); return; }

  // EDIÇÃO — produto único
  if (editandoProdId) {
    await db.collection('produtos').doc(editandoProdId).update({
      codigo: codBase, nome, cor,
      numero: document.getElementById('pNumero').value.trim(),
      estoque: Number(document.getElementById('pEstoque').value),
      valor, custo, estoqueMin,
    });
    fecharModal('modalProduto');
    toast('Produto salvo com sucesso!');
    return;
  }

  // NOVO — verifica se há grade selecionada
  const grade = getGradeSelecionada();
  if (grade.length > 0) {
    const estPorTam = Number(document.getElementById('pEstoquePorTam').value) || 0;
    const batch = db.batch();
    grade.forEach(tam => {
      const ref = db.collection('produtos').doc();
      batch.set(ref, {
        codigo: `${codBase}-${tam}`,
        nome, cor,
        numero: String(tam),
        estoque: estPorTam,
        valor, custo, estoqueMin,
      });
    });
    await batch.commit();
    fecharModal('modalProduto');
    toast(`${grade.length} produtos cadastrados (1 por numeração)!`);
    return;
  }

  // NOVO — produto único (sem grade)
  await db.collection('produtos').add({
    codigo: codBase, nome, cor,
    numero: document.getElementById('pNumero').value.trim(),
    estoque: Number(document.getElementById('pEstoque').value),
    valor, custo, estoqueMin,
  });
  fecharModal('modalProduto');
  toast('Produto salvo com sucesso!');
}

