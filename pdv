<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PDV CHINELOS MIX</title>
<link rel="manifest" href="/pdv-manifest.json">
<meta name="theme-color" content="#22c55e">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="PDV Chinelos Mix">
<link rel="apple-touch-icon" href="/pdv-icon-192.png">
<link rel="icon" type="image/png" sizes="192x192" href="/pdv-icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/pdv-icon-512.png">
<script src="https://unpkg.com/html5-qrcode"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #080c14;
  --bg2: #0d1320;
  --bg3: #111827;
  --bg4: #1a2236;
  --border: #1e2d45;
  --border2: #243452;
  --accent: #00e676;
  --accent2: #00c853;
  --accent-dim: rgba(0,230,118,0.12);
  --accent-dim2: rgba(0,230,118,0.06);
  --red: #ff5252;
  --red-dim: rgba(255,82,82,0.12);
  --blue: #448aff;
  --blue-dim: rgba(68,138,255,0.12);
  --amber: #ffab40;
  --amber-dim: rgba(255,171,64,0.12);
  --text: #e8edf5;
  --text2: #8899b0;
  --text3: #4a5a72;
  --radius: 10px;
  --radius2: 14px;
  --shadow: 0 4px 24px rgba(0,0,0,0.5);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }

/* ── TELA DE LOGIN ── */
#loginScreen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(ellipse at 30% 50%, #0a1f3a 0%, var(--bg) 70%);
}
.login-card {
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: 20px;
  padding: 48px 40px;
  width: 100%;
  max-width: 400px;
  text-align: center;
}
.login-logo { font-family: 'Rajdhani', sans-serif; font-size: 32px; font-weight: 700; color: var(--accent); letter-spacing: 2px; margin-bottom: 4px; }
.login-sub { color: var(--text2); font-size: 13px; margin-bottom: 36px; }
.login-card input, .login-card select {
  width: 100%; padding: 13px 16px; background: var(--bg3);
  border: 1px solid var(--border); border-radius: var(--radius);
  color: var(--text); font-size: 14px; margin-bottom: 12px; outline: none;
  transition: border-color 0.2s;
}
.login-card input:focus, .login-card select:focus { border-color: var(--accent); }
.btn-login {
  width: 100%; padding: 14px; background: var(--accent); border: none;
  border-radius: var(--radius); color: #000; font-size: 15px; font-weight: 600;
  cursor: pointer; transition: all 0.2s; font-family: 'Rajdhani', sans-serif; letter-spacing: 1px;
}
.btn-login:hover { background: var(--accent2); transform: translateY(-1px); }

/* ── LAYOUT PRINCIPAL ── */
#app { display: none; height: 100vh; flex-direction: column; }
#app.active { display: flex; }

/* ── HEADER ── */
.app-header {
  background: var(--bg2); border-bottom: 1px solid var(--border);
  padding: 0 20px; height: 50px; display: flex; align-items: center;
  justify-content: space-between; flex-shrink: 0; z-index: 100;
}
.header-logo { font-family: 'Rajdhani', sans-serif; font-size: 20px; font-weight: 700; color: var(--accent); letter-spacing: 1px; }
.header-info { display: flex; align-items: center; gap: 16px; }
.header-user { font-size: 13px; color: var(--text2); }
.header-user span { color: var(--text); font-weight: 500; }
.header-clock { font-family: 'Rajdhani', sans-serif; font-size: 16px; color: var(--accent); font-weight: 600; }
.btn-logout { padding: 6px 14px; background: transparent; border: 1px solid var(--border); border-radius: 8px; color: var(--text2); font-size: 12px; cursor: pointer; transition: all 0.2s; }
.btn-logout:hover { border-color: var(--red); color: var(--red); }

/* ── LAYOUT BODY ── */
.app-body { display: flex; flex: 1; overflow: hidden; }

/* ── SIDEBAR ── */
.sidebar {
  width: 80px; background: var(--bg2); border-right: 1px solid var(--border);
  display: flex; flex-direction: column; align-items: center; padding: 10px 0; gap: 2px;
  flex-shrink: 0; z-index: 50; overflow-y: auto; overflow-x: hidden;
}
.nav-item {
  width: 70px; min-height: 54px; display: flex; flex-direction: column; align-items: center;
  justify-content: center; border-radius: 12px; cursor: pointer; gap: 3px;
  border: 1px solid transparent; transition: all 0.2s; padding: 6px 4px;
}
.nav-item:hover { background: var(--bg4); border-color: var(--border2); }
.nav-item.active { background: var(--accent-dim); border-color: var(--accent); }
.nav-icon { font-size: 20px; line-height: 1; }
.nav-label { font-size: 10px; color: var(--text2); font-weight: 600; text-align: center; line-height: 1.2; }
.nav-item.active .nav-label { color: var(--accent); }
.nav-divider { width: 50px; height: 1px; background: var(--border); margin: 3px 0; }

/* ── CONTEÚDO ── */
.content { flex: 1; overflow-y: auto; padding: 20px; }
.page { display: none; }
.page.active { display: block; }

/* ── PAGE HEADER ── */
.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.page-title { font-family: 'Rajdhani', sans-serif; font-size: 22px; font-weight: 700; color: var(--text); }
.page-title span { color: var(--accent); }

/* ── CARDS SUMMARY ── */
.summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
.summary-card {
  background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius2);
  padding: 16px; position: relative; overflow: hidden;
}
.summary-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
.summary-card.green::before { background: var(--accent); }
.summary-card.blue::before { background: var(--blue); }
.summary-card.amber::before { background: var(--amber); }
.summary-card.red::before { background: var(--red); }
.summary-label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
.summary-value { font-family: 'Rajdhani', sans-serif; font-size: 24px; font-weight: 700; }
.summary-card.green .summary-value { color: var(--accent); }
.summary-card.blue .summary-value { color: var(--blue); }
.summary-card.amber .summary-value { color: var(--amber); }
.summary-card.red .summary-value { color: var(--red); }

/* ── PANELS ── */
.panel {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: var(--radius2); overflow: hidden; margin-bottom: 16px;
}
.panel-header {
  padding: 14px 18px; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  background: var(--bg3);
}
.panel-title { font-size: 13px; font-weight: 600; color: var(--text); letter-spacing: 0.3px; }
.panel-body { padding: 16px 18px; }

/* ── INPUTS ── */
input, select, textarea {
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: var(--radius); color: var(--text); font-size: 14px;
  padding: 10px 14px; width: 100%; outline: none; transition: border-color 0.2s;
  font-family: 'Inter', sans-serif;
}
input:focus, select:focus { border-color: var(--accent); }
input::placeholder { color: var(--text3); }
label { font-size: 12px; color: var(--text2); display: block; margin-bottom: 5px; font-weight: 500; }
.field { margin-bottom: 12px; }
.row { display: grid; gap: 12px; }
.row.c2 { grid-template-columns: 1fr 1fr; }
.row.c3 { grid-template-columns: 1fr 1fr 1fr; }

/* ── BOTÕES ── */
.btn {
  padding: 10px 18px; border: none; border-radius: var(--radius); font-size: 13px;
  font-weight: 600; cursor: pointer; transition: all 0.2s; display: inline-flex;
  align-items: center; gap: 6px; font-family: 'Inter', sans-serif; white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(0); }
.btn-primary { background: var(--accent); color: #000; }
.btn-primary:hover { background: var(--accent2); }
.btn-secondary { background: var(--bg4); color: var(--text); border: 1px solid var(--border2); }
.btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
.btn-danger { background: var(--red-dim); color: var(--red); border: 1px solid transparent; }
.btn-danger:hover { border-color: var(--red); }
.btn-blue { background: var(--blue-dim); color: var(--blue); border: 1px solid transparent; }
.btn-blue:hover { border-color: var(--blue); }
.btn-amber { background: var(--amber-dim); color: var(--amber); border: 1px solid transparent; }
.btn-sm { padding: 6px 12px; font-size: 12px; }
.btn-icon { width: 34px; height: 34px; padding: 0; justify-content: center; border-radius: 8px; }
.btn-group { display: flex; gap: 8px; flex-wrap: wrap; }

/* ── TABELAS ── */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th { padding: 10px 12px; text-align: left; color: var(--text3); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border); }
td { padding: 11px 12px; border-bottom: 1px solid var(--border); color: var(--text); }
tr:last-child td { border-bottom: none; }
tr:hover td { background: var(--accent-dim2); }

/* ── BADGES ── */
.badge { padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 600; }
.badge-green { background: var(--accent-dim); color: var(--accent); }
.badge-red { background: var(--red-dim); color: var(--red); }
.badge-amber { background: var(--amber-dim); color: var(--amber); }
.badge-blue { background: var(--blue-dim); color: var(--blue); }

/* ── VENDA LAYOUT ── */
.venda-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 12px;
  height: calc(100vh - 110px);
  min-height: 0;
}
.venda-left { display: flex; flex-direction: column; gap: 10px; overflow: hidden; min-height: 0; }
.venda-right { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
.item-lista { overflow-y: auto; flex: 1; min-height: 0; }
.item-row { display: flex; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--border); gap: 8px; }
.item-nome { flex: 1; font-size: 13px; }
.item-qtd { width: 56px; }
.item-qtd input { text-align: center; padding: 5px 4px; font-size: 13px; }
.item-preco { width: 86px; text-align: right; color: var(--accent); font-weight: 600; font-size: 13px; }
.total-bar { background: var(--bg3); border: 1px solid var(--border2); border-radius: var(--radius2); padding: 10px 12px; }
.total-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
.total-line:last-child { margin-bottom: 0; }
.total-label { font-size: 12px; color: var(--text2); }
.total-value { font-family: 'Rajdhani', sans-serif; font-size: 16px; font-weight: 700; }
.total-final { font-size: 20px; color: var(--accent); }
.troco-value { color: var(--amber); font-size: 18px; }

/* ── CAIXA ── */
.caixa-status { display: flex; align-items: center; gap: 10px; padding: 14px 18px; background: var(--bg3); border-radius: var(--radius2); border: 1px solid var(--border); margin-bottom: 16px; }
.caixa-dot { width: 10px; height: 10px; border-radius: 50%; }
.caixa-dot.open { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
.caixa-dot.closed { background: var(--red); }

/* ── RELATÓRIO TABS ── */
.rel-tabs { display: flex; gap: 4px; background: var(--bg3); padding: 4px; border-radius: 10px; margin-bottom: 16px; width: fit-content; }
.rel-tab { padding: 8px 20px; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; color: var(--text2); transition: all 0.2s; border: none; background: transparent; }
.rel-tab.active { background: var(--accent); color: #000; }

/* ── GRAFICOS SIMPLES ── */
.bar-chart { display: flex; align-items: flex-end; gap: 6px; height: 120px; padding: 0 4px; }
.bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; height: 100%; justify-content: flex-end; }
.bar-fill { width: 100%; border-radius: 4px 4px 0 0; background: var(--accent); opacity: 0.7; min-height: 4px; transition: height 0.5s; }
.bar-label { font-size: 10px; color: var(--text2); }
.bar-val { font-size: 10px; color: var(--accent); font-weight: 600; }

/* ── FUNCIONÁRIOS ── */
.func-card { background: var(--bg3); border: 1px solid var(--border); border-radius: var(--radius2); padding: 14px 16px; display: flex; align-items: center; gap: 14px; }
.func-avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--accent-dim); display: flex; align-items: center; justify-content: center; font-family: 'Rajdhani', sans-serif; font-size: 16px; font-weight: 700; color: var(--accent); flex-shrink: 0; }
.func-info { flex: 1; }
.func-nome { font-size: 14px; font-weight: 600; }
.func-cargo { font-size: 12px; color: var(--text2); }
.func-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }

/* ── MODAL ── */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.75); display: none; align-items: center; justify-content: center; z-index: 1000; }
.modal-overlay.open { display: flex; }
.modal { background: var(--bg2); border: 1px solid var(--border2); border-radius: 16px; padding: 28px; width: 90%; max-width: 480px; max-height: 90vh; overflow-y: auto; }
.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.modal-title { font-family: 'Rajdhani', sans-serif; font-size: 18px; font-weight: 700; }
.modal-close { background: transparent; border: none; color: var(--text2); font-size: 22px; cursor: pointer; line-height: 1; }

/* ── BUSCA MODAL ── */
#buscaModal .panel-body { padding: 0; max-height: 400px; overflow-y: auto; }

/* ── SCANNER ── */
.scanner-wrap { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin: 8px 0; }

/* ── EMPTY STATE ── */
.empty { text-align: center; padding: 40px; color: var(--text3); }
.empty-icon { font-size: 36px; margin-bottom: 8px; }

/* ── SCROLL ── */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }

/* ── NOTIF ── */
.toast { position: fixed; bottom: 20px; right: 20px; background: var(--bg2); border: 1px solid var(--border2); border-radius: 10px; padding: 12px 18px; font-size: 13px; color: var(--text); z-index: 9999; display: none; gap: 8px; align-items: center; box-shadow: var(--shadow); }
.toast.show { display: flex; }
.toast.success { border-color: var(--accent); }
.toast.error { border-color: var(--red); }

/* ── RESPONSIVE — ajuste automático ── */
html, body { height: 100%; overflow: hidden; }
#app { height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
#app.active { display: flex; }
.app-header { height: 50px; flex-shrink: 0; }
.app-body { flex: 1; display: flex; overflow: hidden; min-height: 0; }
.sidebar { overflow-y: auto; overflow-x: hidden; }
.content { flex: 1; overflow-y: auto; overflow-x: hidden; min-height: 0; padding: 14px; }
.page-header { margin-bottom: 14px; }

@media (max-width: 1200px) {
  .venda-layout { grid-template-columns: 1fr 280px; }
}
@media (max-width: 960px) {
  .venda-layout { grid-template-columns: 1fr; height: auto; }
  .venda-right { height: auto; max-height: none; }
  .summary-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .sidebar { width: 70px; }
  .nav-item { width: 62px; }
  .content { padding: 8px; }
  .app-header { padding: 0 8px; }
  .header-user { display: none; }
  .row.c2, .row.c3 { grid-template-columns: 1fr; }
  .func-grid { grid-template-columns: 1fr; }
  .page-title { font-size: 16px; }
  .rel-tabs { flex-wrap: wrap; }
}
@media (max-height: 680px) {
  .app-header { height: 44px; }
  .venda-layout { height: calc(100vh - 100px); }
  .panel-body { padding: 7px 12px; }
  .panel-header { padding: 8px 14px; }
  .summary-card { padding: 9px 12px; }
  .summary-value { font-size: 17px; }
  .field { margin-bottom: 7px; }
  input, select { padding: 7px 10px; font-size: 13px; }
  .btn { padding: 8px 14px; font-size: 12px; }
  .total-bar { padding: 8px 10px; }
  .nav-item { min-height: 48px; }
}
@media (max-height: 560px) {
  .venda-layout { height: calc(100vh - 90px); }
  .panel-body { padding: 5px 10px; }
  .field { margin-bottom: 4px; }
  input, select { padding: 5px 8px; font-size: 12px; }
  .nav-label { font-size: 8px; }
  .nav-item { min-height: 40px; }
  .summary-grid { grid-template-columns: 1fr 1fr; }
}
</style>
</head>
<body>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="login-card">
    <div style="text-align:center;margin-bottom:16px">
      <img src="/pdv-logo.png" style="max-width:180px;max-height:80px;object-fit:contain;border-radius:10px">
    </div>
    <div class="login-sub">Sistema de Ponto de Venda</div>
    <div class="field">
      <label>Nome do funcionário</label>
      <input id="loginNome" placeholder="Seu nome completo">
    </div>
    <div class="field">
      <label>Senha</label>
      <input id="loginSenha" type="password" placeholder="••••••">
    </div>
    <button class="btn-login" onclick="fazerLogin()">ENTRAR NO SISTEMA</button>
    <button id="btnInstalarAppLogin" type="button" onclick="instalarApp()" style="display:none;width:100%;margin-top:10px;padding:12px;background:transparent;border:1.5px solid #22c55e;color:#22c55e;border-radius:8px;font-weight:700;cursor:pointer">📲 Baixar como Aplicativo</button>
  </div>
</div>

<!-- APP -->
<div id="app">
  <!-- HEADER -->
  <header class="app-header">
    <div class="header-logo"><img src="/pdv-logo.png" style="height:36px;object-fit:contain;vertical-align:middle;border-radius:6px"></div>
    <div class="header-info">
      <div class="header-user">Operador: <span id="headerNome">—</span></div>
      <div class="header-clock" id="relogio">00:00:00</div>
      <button id="btnInstalarApp" class="btn-logout" style="display:none;background:#22c55e;border-color:#22c55e;color:#fff" onclick="instalarApp()" title="Instalar como aplicativo no celular">📲 Baixar App</button>
      <button class="btn-logout" onclick="sair()">Sair</button>
    </div>
  </header>

  <div class="app-body">
    <!-- SIDEBAR -->
    <nav class="sidebar">
      <div class="nav-item active" onclick="navegar('venda')" id="nav-venda">
        <div class="nav-icon">🛒</div>
        <div class="nav-label">Venda</div>
      </div>
      <div class="nav-item" onclick="navegar('produtos')" id="nav-produtos">
        <div class="nav-icon">📦</div>
        <div class="nav-label">Estoque</div>
      </div>
      <div class="nav-divider"></div>
      <div class="nav-item" onclick="navegar('caixa')" id="nav-caixa">
        <div class="nav-icon">💰</div>
        <div class="nav-label">Caixa</div>
      </div>
      <div class="nav-item" onclick="navegar('relatorio')" id="nav-relatorio">
        <div class="nav-icon">📊</div>
        <div class="nav-label">Relatório</div>
      </div>
      <div class="nav-divider"></div>
      <div class="nav-item" onclick="navegar('funcionarios')" id="nav-funcionarios">
        <div class="nav-icon">👥</div>
        <div class="nav-label">Equipe</div>
      </div>
      <div class="nav-item" onclick="navegar('troca')" id="nav-troca">
        <div class="nav-icon">🔄</div>
        <div class="nav-label">Troca</div>
      </div>
    </nav>

    <!-- CONTEÚDO -->
    <main class="content">

      <!-- ══ VENDA ══ -->
      <div class="page active" id="page-venda">
        <div class="page-header">
          <div class="page-title">Nova <span>Venda</span></div>
          <div style="font-size:12px;color:var(--text2)" id="vendaData"></div>
        </div>
        <div class="venda-layout">
          <!-- ESQUERDA -->
          <div class="venda-left">
            <div class="panel" style="flex-shrink:0">
              <div class="panel-header"><div class="panel-title">Adicionar Produto</div></div>
              <div class="panel-body">
                <div class="row c3">
                  <div class="field" style="margin:0;grid-column:span 2">
                    <label>Código / Busca</label>
                    <input id="codVenda" placeholder="Digite ou escaneie..." onkeydown="if(event.key==='Enter') adicionarPorCodigo()">
                  </div>
