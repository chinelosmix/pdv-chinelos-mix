    const baixo = p.estoque <= (p.estoqueMin || 5);
    return `<tr>
      <td><code style="font-size:11px;color:var(--text2)">${p.codigo}</code></td>
      <td><strong>${p.nome}</strong></td>
      <td>${p.cor||'—'}</td>
      <td>${p.numero||'—'}</td>
      <td><span class="badge ${baixo ? 'badge-red' : 'badge-green'}">${p.estoque}</span></td>
      <td style="color:var(--accent);font-weight:600">R$ ${Number(p.valor||0).toFixed(2)}</td>
      <td style="color:var(--text2)">R$ ${Number(p.custo||0).toFixed(2)}</td>
      <td>${(()=>{ const v=Number(p.valor||0), c=Number(p.custo||0), m=v-c, pct=v>0?((m/v)*100).toFixed(0):0; return `<span style="color:${m>=0?'var(--accent)':'var(--red)'}">${pct}%</span> <span style="font-size:11px;color:var(--text3)">R$ ${m.toFixed(2)}</span>`; })()}</td>
      <td>
