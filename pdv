async function fazerLogin() {
  const nome = document.getElementById('loginNome').value.trim();
  const senha = document.getElementById('loginSenha').value;
  if (!nome) { toast('Digite seu nome', 'error'); return; }

  // Verifica funcionário no Firestore
  const snap = await db.collection('funcionarios').where('nome','==',nome).get();
  let func = null;
  if (!snap.empty) {
    const doc = snap.docs[0];
    const data = doc.data();
    if (data.senha && data.senha !== senha) { toast('Senha incorreta', 'error'); return; }
    func = { id: doc.id, ...data };
  } else {
    // Primeiro acesso — cria como admin
    func = { nome, cargo: 'Proprietário(a)', permissao: 'admin' };
  }

  usuario = func;
  document.getElementById('headerNome').textContent = usuario.nome;
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('app').classList.add('active');
  iniciar();
}

